# Copy to backend/.env and frontend/.env.local. Never commit the copies.

# ---------- backend ----------
# manage.py defaults to config.settings.dev, wsgi/asgi to config.settings.prod,
# pytest to config.settings.test. Override with DJANGO_SETTINGS_MODULE if needed.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Neon connection string (dev branch locally, main branch in production)
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/ravaya?sslmode=require
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production only: https://ravaya.<tld>
CSRF_TRUSTED_ORIGINS=
# Domain for the refresh cookie. Empty in development (host-only cookie).
# Production: the shared parent domain, e.g. .ravaya.example
AUTH_COOKIE_DOMAIN=

# AI
GEMINI_API_KEY=
AI_CHAT_MODEL=gemini-3.8-flash
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIM=768
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1000
AI_RATE_PER_MIN=10
AI_RATE_PER_DAY=100
AI_DAILY_SPEND_LIMIT_USD=5
# USD per 1M tokens for AI_CHAT_MODEL — copy from Google's current pricing page.
# Used to turn stored token counts into spend. Leave empty and the AI endpoints fail closed.
AI_PRICE_INPUT_PER_MTOK_USD=
AI_PRICE_OUTPUT_PER_MTOK_USD=

# payments (mock in development)
PAYMENT_PROVIDER=mock
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Minutes an unpaid online order holds its stock before it is auto-cancelled
PAYMENT_HOLD_MINUTES=30

# store
STORE_VAT_RATE=15
STORE_CURRENCY=SAR
STORE_FREE_SHIPPING_ABOVE=300
STORE_FLAT_SHIPPING=25
WHATSAPP_NUMBER=

# media + monitoring
CLOUDINARY_URL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---------- frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SENTRY_DSN=
